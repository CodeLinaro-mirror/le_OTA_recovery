#!bin/sh /etc/rc.common

USE_PROCD=1
START=90

start_service() {
    procd_open_instance
    procd_set_param command ./usr/bin/recovery-updater.sh
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
